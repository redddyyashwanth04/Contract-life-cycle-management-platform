# ClausIQ environment configuration
# Copy this file to `.env` and fill in your values, OR set these as
# environment variables from your terminal (see README.md).

# Groq (free tier) API key — https://console.groq.com/keys
GROQ_API_KEY=

# Model to use for all agentic tasks (free tier supports llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Maximum negotiation rounds between the two agents
MAX_NEGOTIATION_ROUNDS=6

# Session lifetime for the dummy login (seconds)
SESSION_TTL_SECONDS=28800

# Optional: where the SQLite database lives
CLAUSIQ_DATA_DIR=data
